inputs:
	InputData( numericseries ),
	BarCount( numericsimple ),
	NotStrict( truefalse );

vars:	
	IsRising( 0 ), PrevValue(0), CurrValue(0), Index(0);
	
PrevValue = InputData[BarCount-1];
IsRising = 0;


If StrToNum(Formatdate("yyyyMMdd", ElDateToDateTime(Date))) = 20100622 and StrToNum(FormatTime("Hmm", ElTimeToDateTime(Time))) = 1045 then begin
	Print("InputData[BarCount-1]: ", InputData[BarCount-1], ",InputData[BarCount-2]: ", InputData[BarCount-2], ",InputData[BarCount-3]: ", InputData[BarCount-3]);
end;

For Index = 1 to BarCount-1 begin

	CurrValue = InputData[BarCount - 1 - Index];	
	
	If (CurrValue < PrevValue) then begin
		// indicator is falling, not rising
		IsRising = 0;
		break;
	end;
			
	if(NotStrict = false and CurrValue = PrevValue) then begin
		IsRising = 0;
		break;
	end;
	
	if(CurrValue > PrevValue) then begin
		IsRising = 1;
	end;
	
	PrevValue = CurrValue;
end;

SQ_IsRising = IsRising;
