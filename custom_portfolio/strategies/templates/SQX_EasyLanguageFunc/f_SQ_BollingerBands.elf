inputs:
	Price( numericseries ),
	Period( numericsimple ),
	Deviation( numericsimple ),
	Line( numericsimple );
	
If Line = 1 then
	SQ_BollingerBands = Average( Price, Period ) - Deviation * StandardDev( Price, Period, 1 )	{Lower}
Else 
	SQ_BollingerBands = Average( Price, Period ) + Deviation * StandardDev( Price, Period, 1 );	{Upper}
	
{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value10 = SQ_BollingerBands[1]
