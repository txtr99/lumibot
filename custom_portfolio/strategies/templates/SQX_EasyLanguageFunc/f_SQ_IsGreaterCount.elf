inputs:
	LeftInputData( numericseries ),
	RightInputData( numericseries ),
	BarCount( numericsimple ),
	NotStrict( truefalse );

vars:	
	IsGreaterCount( 0 ),LeftCurrValue(0),RightCurrValue(0), Index(0);
	
IsGreaterCount = 0;

For Index = 0 to BarCount-1 begin

	LeftCurrValue = Round(LeftInputData[Index],5);	
	RightCurrValue = Round(RightInputData[Index],5);

	If (LeftCurrValue < RightCurrValue) then begin
	IsGreaterCount =0;
		break;
	end;
	
	If (NotStrict = false  and LeftCurrValue = RightCurrValue ) then begin
		IsGreaterCount =0;
		break;
	end;
	
	If (LeftCurrValue > RightCurrValue) then begin
		IsGreaterCount =1;
	end;

end;

SQ_IsGreaterCount = IsGreaterCount;
