inputs: Length( numericsimple ), NumDevs( numericsimple ), Unused( numericsimple );

SQ_BollingerBandDown = Average( Close, Length ) - NumDevs * StandardDev( Close, Length, 1 ) ;
{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value3 = SQ_BollingerBandDown[1];
