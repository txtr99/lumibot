inputs:
	InputData( numericseries ),
	Perc( numericsimple ),
	BarCount( numericsimple );
	

vars:	
	IsGreaterPercentile( 0 ),CurrValue(0),PrevValue(0), Index(0),count(1),percrank(0);
	
IsGreaterPercentile = 0;
percrank = 0;
count = 0;


//For Index = 1 to BarCount begin
For Index = 0 to BarCount-1 begin

	CurrValue = Round(InputData[0],5);	
	PrevValue = Round(InputData[Index+1],5);

	If (CurrValue > PrevValue) then 
		count = count +1;
			
end;

percrank = count/BarCount*100;

If (percrank >Perc) then begin

	IsGreaterPercentile = 1;
end;


SQ_IsGreaterPercentile = IsGreaterPercentile; 
