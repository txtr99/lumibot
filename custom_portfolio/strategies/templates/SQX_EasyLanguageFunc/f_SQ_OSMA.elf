inputs:
	Price( numericseries ),
	FastEMA( numericsimple ),
	SlowEMA( numericsimple ),
	SignalPeriod( numericsimple );

variables:
	macdAverage( 0 );
	

SQ_OSMA = SQ_EMA(Price, FastEMA) - SQ_EMA(Price, SlowEMA) - SQ_SMA(SQ_EMA(Price, FastEMA) - SQ_EMA(Price, SlowEMA), SignalPeriod);

{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value10 = SQ_OSMA[1];
