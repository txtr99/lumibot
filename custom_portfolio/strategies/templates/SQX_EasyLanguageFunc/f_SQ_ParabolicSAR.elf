inputs:
	double AfStep( numericsimple ),
	double AfLimit( numericsimple );
	
variables:
	intrabarpersist bool PlotCrossBarsAgo( false ),
	double oParCl( 0 ),
	double oParOp( 0 ),
	double oPosition( 0 ),
	double oTransition( 0 );
	
Value1 = ParabolicSAR( AfStep, AfLimit, oParCl, oParOp, oPosition, oTransition );

SQ_ParabolicSAR = oParOp;

{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value10 = SQ_ParabolicSAR[1];
