inputs: 
timeFrom( StringSimple ), timeTo( StringSimple ) ;

vars:
sqTimeFrom(-1), sqTimeTo(-1), _startDate(0), _endDate(0), lowestValue(10000000), lastValue(0), lastUsableValue(0);
	
If sqTimeFrom < 0 then begin
	sqTimeFrom = SQ_TimeToInt(timeFrom);
	sqTimeTo = SQ_TimeToInt(timeTo);
	
	_startDate = Date;
	_endDate = Date;
	
	if sqTimeTo <= sqTimeFrom Then _endDate = CalcDate(Date, 1);
End;

If (Date > _endDate or (Date = _endDate and Time >= sqTimeTo)) Then Begin
	_startDate = Date;
	_endDate = Date;
	
	lastValue = lowestValue;
	lowestValue = 10000000;
	
	If sqTimeTo <= Time Then begin
		If sqTimeTo < sqTimeFrom Then begin
			_endDate = CalcDate(_endDate, 1);
		end
		Else begin
			_startDate = CalcDate(_startDate, 1);
			_endDate = CalcDate(_endDate, 1);
		end;
	end;
	
	If sqTimeFrom <= Time Then lowestValue = Low;
end
Else begin
	If (Date > _startDate or (Date = _startDate and Time >= sqTimeFrom)) Then lowestValue = MinList(lowestValue, Low) Else lowestValue = 10000000;
end;

If lastValue < 10000000 Then begin
	lastUsableValue = lastValue;
	SQ_LowestInRange = lastValue;
end
Else SQ_LowestInRange = lastUsableValue;

{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value10 = SQ_LowestInRange[1];
