inputs: 
	Price( numericseries ), 
	Period( numericsimple );  { this input is assumed to be constant }
variables:
	ExtremeValLow( 0 ),
	ExtremeLowBar( 0 ),
	RetVal( 0 ) ;

RetVal = SQ_Extremes(Price, Period, -1, ExtremeValLow, ExtremeLowBar); 
SQ_Lowest = ExtremeValLow;

{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value3 = SQ_Lowest[1];
