inputs: 
	VWAPPeriod(numericsimple);


vars:
index(0),
	__ohlcvTotal(0),
	__volumeTotal(0),
	ohlcAvg(0),
	vol(0), 
	__vvap (0);
	
ohlcAvg = 0;
vol = 1; 
index=0; 
__vvap=1;
__ohlcvTotal=0;
__volumeTotal=0;


For index=0 To VWAPPeriod-1 Begin

ohlcAvg = (open[index]+high[index]+low[index]+close[index])/4;
vol = volume[index];

__ohlcvTotal+= ohlcAvg * vol;
__volumeTotal += vol;

	
End;
if __volumeTotal = 0 then __volumeTotal= 1 ;
if VWAPPeriod<4  then __vvap =AvgPrice
else 
__vvap=__ohlcvTotal/__volumeTotal;

SQ_VWAP = __vvap;	 

{ Force series function, since otherwise this function can verify as simple, but needs to be called at every bar to return correct results }
If false then Value10 = __vvap[1];
